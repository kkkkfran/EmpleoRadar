# Discord Configuration
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_CHANNEL_INFORMATICA_ID=1561207531659985106
DISCORD_CHANNEL_CHILLAN_ID=1561217778722283613

# Database
DATABASE_URL=sqlite+aiosqlite:///data/empleoradar.db

# Timezone
TIMEZONE=America/Santiago

# Logging
LOG_LEVEL=INFO

# Job Sources
POLL_INTERVAL_MINUTES=2
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT_SECONDS=30
SOURCE_TIMEOUT_SECONDS=180
RECOVERY_DAYS=4

# Healthcheck (Railway proporciona PORT automáticamente)
PORT=8080

# CV Storage
CV_STORAGE_DIR=data/private/resumes

# Application Settings
APPLICATION_REQUIRE_CONFIRMATION=true

# Backup
BACKUP_DIR=data/backups
